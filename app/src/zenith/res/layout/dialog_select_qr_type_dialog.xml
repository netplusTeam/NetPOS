<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/select_qr_type"
            android:textColor="@color/colorPrimary"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <RadioGroup
            android:id="@+id/qr_types"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="0dp"
            app:layout_constraintTop_toBottomOf="@id/header">

            <RadioButton
                android:id="@+id/masterpass_qr_"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/masterpass_qr_type"
                android:textAllCaps="true" />

            <RadioButton
                android:id="@+id/mvisa_qr_"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mvisa_qr_type"
                android:textAllCaps="true" />

            <RadioButton
                android:id="@+id/nibss_qr_"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nibss_qr_type"
                android:textAllCaps="true" />

        </RadioGroup>

        <Button
            android:id="@+id/cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/cancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/qr_types" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>